# E-License Classification + OCR Evaluation App — environment template.
# Copy to .env and fill in values. Loaded by eval/config.py via python-dotenv.

# --- Postgres (docker-compose brings this up on host port 5435) ---
# DB_DSN is derived per-model as evalutea_<model_slug> (see eval/config.py).
# Uncomment to pin explicitly:
# DB_DSN=

# --- LLM endpoint (OpenAI-compatible chat/completions) ---
LLM_ENDPOINT=
MODEL_API_KEY=
MODEL_NAME=

# --- Page-PNG cache (rendered on demand, keyed by sha256) ---
CACHE_DIR=

# --- GET-mock JSON tree root (the source of petition metadata) ---
MOCK_ROOT=

# --- raw-petition browser: globe buttons link to {base}/api/petition?name=GET_*.json ---
PETITION_API_BASE=

# --- local filesystem roots (override the defaults in config.py) ---
DOC_ROOT=
GEO_MASTER_DIR=

# --- per-filetype production extractor (eval.ai.extract) ---
ELICENSE_REPO_PATH=
CENTRAL_OCR_BASE_URL=
# Per-request timeout for the production ChatCompletionsService (seconds).
LLM_TIMEOUT=

# --- QualityScore service (scorer_service.py, DeQA-Doc page quality) ---
QUALITY_MODEL=
# Physical GPU the scorer subprocess lands on (passed as CUDA_VISIBLE_DEVICES).
QUALITY_CUDA_VISIBLE_DEVICES=
# Torch device for the scorer (keep cuda:0 — relative to the GPU above).
QUALITY_DEVICE=
# Batch mode: pages per model forward (single worker, one batched request).
QUALITY_BATCH_SIZE=
# Parallel CPU-side page renders feeding the batch (PyMuPDF, thread-safe).
QUALITY_RENDER_THREADS=
